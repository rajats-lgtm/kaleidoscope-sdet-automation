# Copy to .env and adjust. Every value is optional.

# Program under test
BASE_URL=https://apply.mykaleidoscope.com/program/sdet-test-scholarship

# Browser behaviour
HEADLESS=true
SLOW_MO=0

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Unique-user generation.
# Option A (default): <prefix>+<unique>@TEST_EMAIL_DOMAIN
TEST_EMAIL_DOMAIN=example.com
# Option B: plus-address a real inbox, e.g. qa.inbox@gmail.com
# -> qa.inbox+<unique>@gmail.com (useful if email verification is ever enforced)
TEST_EMAIL_BASE=
